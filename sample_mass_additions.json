{
  "servicenow": {
    "base_url": "https://YOUR-INSTANCE.service-now.com",
    "bearer_token_env": "SNOW_BEARER_TOKEN",
    "api_key_env": "SNOW_API_KEY",
    "table": "alm_hardware",
    "verify_ssl": true,
    "require_proxy": false,

    "asset_tag_field": "asset_tag",
    "serial_number_field": "serial_number",
    "location_id_field": "location.u_fin_location_id",
    "expense_ccid_field": "cost_center.value",
    "employee_id_field": "assigned_to.u_employee_id",
    "category_field": "model_category.name",
    "ccid_active_field": null,
    "extra_fields": []
  },

  "oracle": {
    "mode": "fusion",
    "base_url": "https://YOUR-FA.fa.ocs.oraclecloud.com",
    "api_version": "11.13.18.05",
    "bearer_token_env": "FUSION_JWT",
    "verify_ssl": true,
    "require_proxy": false,
    "timeout_seconds": 60,

    "mass_additions_resource": "FAmassAdditions",
    "tag_number_attribute": "Attribute1",
    "serial_number_attribute": "Attribute5",
    "page_size": 500,

    "_alternate_offline_mode": "Set mode to 'mock_csv' and supply 'mock_csv' for an offline run that reads NEW rows from a CSV file instead of Fusion.",
    "mock_csv": "data/samples/mass_additions_pilot.csv"
  },

  "pilot_book": "CORP_BOOK",
  "pilot_region": "US",
  "capitalize_threshold_amount": 1000.0
}
