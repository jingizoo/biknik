{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "assetNumber",
      "type": "promptString",
      "description": "Asset Number (e.g. 125183)"
    },
    {
      "id": "assetId",
      "type": "promptString",
      "description": "Asset ID (e.g. 706)"
    },
    {
      "id": "bookCode",
      "type": "promptString",
      "description": "Book Type Code (e.g. UK CORP BOOK)"
    },
    {
      "id": "destBookCode",
      "type": "promptString",
      "description": "Destination Book Type Code (e.g. US CORP BOOK)"
    },
    {
      "id": "locationCcid",
      "type": "promptString",
      "description": "Destination Location CCID from CMDB (leave empty to keep source location)"
    },
    {
      "id": "retirementType",
      "type": "promptString",
      "description": "Retirement Type (SALE or ABANDONMENT)",
      "default": "SALE"
    },
    {
      "id": "retirementDate",
      "type": "promptString",
      "description": "Retirement Date (YYYY-MM-DD, leave empty for today)",
      "default": ""
    },
    {
      "id": "proceeds",
      "type": "promptString",
      "description": "Proceeds of Sale (e.g. 50000, default 0)",
      "default": "0"
    },
    {
      "id": "unitsToRetire",
      "type": "promptString",
      "description": "Units to Retire (leave empty for full retirement)",
      "default": ""
    },
    {
      "id": "periodName",
      "type": "promptString",
      "description": "FA Period Name (e.g. Jan-26, Feb-26)",
      "default": ""
    },
    {
      "id": "postRetireStep",
      "type": "pickString",
      "description": "Which post-retirement step(s) to run?",
      "options": ["all", "1 (Depreciation)", "2 (Create Accounting)", "3 (Close Period)"],
      "default": "all"
    },
    {
      "id": "retReferenceNum",
      "type": "promptString",
      "description": "Retirement Reference Number (leave empty to skip update)",
      "default": ""
    },
    {
      "id": "ledgerName",
      "type": "promptString",
      "description": "Ledger Name for Create Accounting (e.g. US Primary Ledger)"
    },
    {
      "id": "fusionBaseUrl",
      "type": "promptString",
      "description": "Fusion Base URL (e.g. https://your-fusion-host.oraclecloud.com)"
    },
    {
      "id": "fusionApiVersion",
      "type": "promptString",
      "description": "Fusion API Version",
      "default": "11.13.18.05"
    },
    {
      "id": "fusionJwt",
      "type": "promptString",
      "description": "Fusion JWT token",
      "password": true
    },
    {
      "id": "cmdbBaseUrl",
      "type": "promptString",
      "description": "CMDB (ServiceNow) Base URL (e.g. https://your-instance.service-now.com)"
    },
    {
      "id": "cmdbUser",
      "type": "promptString",
      "description": "CMDB Username"
    },
    {
      "id": "cmdbPass",
      "type": "promptString",
      "description": "CMDB Password",
      "password": true
    },
    {
      "id": "fusionUser",
      "type": "promptString",
      "description": "Fusion Username (for Basic Auth)"
    },
    {
      "id": "fusionPass",
      "type": "promptString",
      "description": "Fusion Password (for Basic Auth)",
      "password": true
    },
    {
      "id": "cmdbQuery",
      "type": "promptString",
      "description": "Additional CMDB filter (e.g. company=Citadel) — leave empty for none",
      "default": ""
    },
    {
      "id": "mismatchLimit",
      "type": "pickString",
      "description": "Max mismatches to find",
      "options": ["10", "20", "50", "100"],
      "default": "10"
    }
  ],
  "configurations": [
    //
    // ── TRANSFER ─────────────────────────────────────────────
    //
    {
      "name": "Transfer — dry-run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_transfer.py",
      "args": [
        "--asset-number",    "${input:assetNumber}",
        "--asset-id",        "${input:assetId}",
        "--book-code",       "${input:bookCode}",
        "--dest-book-code",  "${input:destBookCode}",
        "--location-ccid",   "${input:locationCcid}"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Transfer — EXECUTE",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_transfer.py",
      "args": [
        "--asset-number",    "${input:assetNumber}",
        "--asset-id",        "${input:assetId}",
        "--book-code",       "${input:bookCode}",
        "--dest-book-code",  "${input:destBookCode}",
        "--location-ccid",   "${input:locationCcid}",
        "--execute"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    //
    // ── POST-RETIREMENT PIPELINE (ESS Jobs) ─────────────────
    //
    {
      "name": "Post-Retire — dry-run (all steps)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",      "${input:bookCode}",
        "--asset-id",       "${input:assetId}",
        "--ledger-name",    "${input:ledgerName}",
        "--step",           "all"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Post-Retire — EXECUTE (depreciation + accounting)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",      "${input:bookCode}",
        "--asset-id",       "${input:assetId}",
        "--ledger-name",    "${input:ledgerName}",
        "--step",           "all",
        "--execute"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Post-Retire — EXECUTE (all + close period)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",      "${input:bookCode}",
        "--asset-id",       "${input:assetId}",
        "--ledger-name",    "${input:ledgerName}",
        "--period-name",    "${input:periodName}",
        "--step",           "all",
        "--execute",
        "--close-period"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Post-Retire — single step (pick which)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",      "${input:bookCode}",
        "--asset-id",       "${input:assetId}",
        "--ledger-name",    "${input:ledgerName}",
        "--period-name",    "${input:periodName}",
        "--step",           "${input:postRetireStep}",
        "--execute"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Post-Retire — update retirement ref + run all",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",          "${input:bookCode}",
        "--asset-id",           "${input:assetId}",
        "--ledger-name",        "${input:ledgerName}",
        "--ret-reference-num",  "${input:retReferenceNum}",
        "--step",               "all",
        "--execute"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    //
    // ── CMDB → FA LOCATION SYNC TESTER ────────────────────────
    //
    {
      "name": "CMDB Sync — find mismatches (dry-run)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tester_cmdb_fa.py",
      "args": [
        "--limit",  "${input:mismatchLimit}"
      ],
      "env": {
        "CMDB_BASE_URL":      "${input:cmdbBaseUrl}",
        "CMDB_USER":          "${input:cmdbUser}",
        "CMDB_PASS":          "${input:cmdbPass}",
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_USER":        "${input:fusionUser}",
        "FUSION_PASS":        "${input:fusionPass}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "CMDB Sync — find mismatches + EXECUTE transfer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tester_cmdb_fa.py",
      "args": [
        "--limit",   "${input:mismatchLimit}",
        "--execute"
      ],
      "env": {
        "CMDB_BASE_URL":      "${input:cmdbBaseUrl}",
        "CMDB_USER":          "${input:cmdbUser}",
        "CMDB_PASS":          "${input:cmdbPass}",
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_USER":        "${input:fusionUser}",
        "FUSION_PASS":        "${input:fusionPass}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "CMDB Sync — with CMDB filter (dry-run)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tester_cmdb_fa.py",
      "args": [
        "--limit",       "${input:mismatchLimit}",
        "--cmdb-query",  "${input:cmdbQuery}"
      ],
      "env": {
        "CMDB_BASE_URL":      "${input:cmdbBaseUrl}",
        "CMDB_USER":          "${input:cmdbUser}",
        "CMDB_PASS":          "${input:cmdbPass}",
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_USER":        "${input:fusionUser}",
        "FUSION_PASS":        "${input:fusionPass}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    //
    // ── UNIT TESTS ────────────────────────────────────────────
    //
    {
      "name": "Run All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src/main/python"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Run CMDB Tests Only",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_cmdb_client.py",
        "tests/test_location_resolver.py",
        "tests/test_cmdb_sync.py",
        "-v"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src/main/python"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
