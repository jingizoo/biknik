{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "assetNumber",
      "type": "promptString",
      "description": "Asset Number (e.g. 125183)"
    },
    {
      "id": "assetId",
      "type": "promptString",
      "description": "Asset ID (e.g. 706)"
    },
    {
      "id": "bookCode",
      "type": "promptString",
      "description": "Book Type Code (e.g. UK CORP BOOK)"
    },
    {
      "id": "destBookCode",
      "type": "promptString",
      "description": "Destination Book Type Code (e.g. US CORP BOOK)"
    },
    {
      "id": "locationCcid",
      "type": "promptString",
      "description": "Destination Location CCID from CMDB (leave empty to keep source location)"
    },
    {
      "id": "retirementType",
      "type": "promptString",
      "description": "Retirement Type (SALE or ABANDONMENT)",
      "default": "SALE"
    },
    {
      "id": "retirementDate",
      "type": "promptString",
      "description": "Retirement Date (YYYY-MM-DD, leave empty for today)",
      "default": ""
    },
    {
      "id": "proceeds",
      "type": "promptString",
      "description": "Proceeds of Sale (e.g. 50000, default 0)",
      "default": "0"
    },
    {
      "id": "unitsToRetire",
      "type": "promptString",
      "description": "Units to Retire (leave empty for full retirement)",
      "default": ""
    },
    {
      "id": "periodName",
      "type": "promptString",
      "description": "FA Period Name (e.g. Jan-26, Feb-26)",
      "default": ""
    },
    {
      "id": "postRetireStep",
      "type": "pickString",
      "description": "Which post-retirement step(s) to run?",
      "options": ["all", "1 (Depreciation)", "2 (Create Accounting)", "3 (Close Period)"],
      "default": "all"
    },
    {
      "id": "retReferenceNum",
      "type": "promptString",
      "description": "Retirement Reference Number (leave empty to skip update)",
      "default": ""
    },
    {
      "id": "ledgerName",
      "type": "promptString",
      "description": "Ledger Name for Create Accounting (e.g. US Primary Ledger)"
    },
    {
      "id": "fusionBaseUrl",
      "type": "promptString",
      "description": "Fusion Base URL (e.g. https://your-fusion-host.oraclecloud.com)"
    },
    {
      "id": "fusionApiVersion",
      "type": "promptString",
      "description": "Fusion API Version",
      "default": "11.13.18.05"
    },
    {
      "id": "fusionJwt",
      "type": "promptString",
      "description": "Fusion JWT token",
      "password": true
    }
  ],
  "configurations": [
    //
    // ── TRANSFER ─────────────────────────────────────────────
    //
    {
      "name": "Transfer — dry-run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_transfer.py",
      "args": [
        "--asset-number",    "${input:assetNumber}",
        "--asset-id",        "${input:assetId}",
        "--book-code",       "${input:bookCode}",
        "--dest-book-code",  "${input:destBookCode}",
        "--location-ccid",   "${input:locationCcid}"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Transfer — EXECUTE",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_transfer.py",
      "args": [
        "--asset-number",    "${input:assetNumber}",
        "--asset-id",        "${input:assetId}",
        "--book-code",       "${input:bookCode}",
        "--dest-book-code",  "${input:destBookCode}",
        "--location-ccid",   "${input:locationCcid}",
        "--execute"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    //
    // ── POST-RETIREMENT PIPELINE (ESS Jobs) ─────────────────
    //
    {
      "name": "Post-Retire — dry-run (all steps)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",      "${input:bookCode}",
        "--asset-id",       "${input:assetId}",
        "--ledger-name",    "${input:ledgerName}",
        "--step",           "all"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Post-Retire — EXECUTE (depreciation + accounting)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",      "${input:bookCode}",
        "--asset-id",       "${input:assetId}",
        "--ledger-name",    "${input:ledgerName}",
        "--step",           "all",
        "--execute"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Post-Retire — EXECUTE (all + close period)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",      "${input:bookCode}",
        "--asset-id",       "${input:assetId}",
        "--ledger-name",    "${input:ledgerName}",
        "--period-name",    "${input:periodName}",
        "--step",           "all",
        "--execute",
        "--close-period"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Post-Retire — single step (pick which)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",      "${input:bookCode}",
        "--asset-id",       "${input:assetId}",
        "--ledger-name",    "${input:ledgerName}",
        "--period-name",    "${input:periodName}",
        "--step",           "${input:postRetireStep}",
        "--execute"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Post-Retire — update retirement ref + run all",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_post_retire.py",
      "args": [
        "--book-code",          "${input:bookCode}",
        "--asset-id",           "${input:assetId}",
        "--ledger-name",        "${input:ledgerName}",
        "--ret-reference-num",  "${input:retReferenceNum}",
        "--step",               "all",
        "--execute"
      ],
      "env": {
        "FUSION_BASE_URL":    "${input:fusionBaseUrl}",
        "FUSION_API_VERSION": "${input:fusionApiVersion}",
        "FUSION_JWT":         "${input:fusionJwt}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
