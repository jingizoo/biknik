# Production deployment posture. Copy to the platform's secret/config manager;
# do not commit real values.
APP_MODE=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a high-entropy one-time code (for example, 32 random bytes encoded
# safely), deliver it to the client through a secure channel, and remove it from
# configuration after the installation is claimed.
INITIAL_SETUP_CODE=REPLACE_WITH_ONE_TIME_HIGH_ENTROPY_CODE

# Emergency operations bootstrap remains supported. Leave unset for the normal
# client-owned browser claim so the deployment operator never handles the
# client's password.
# BOOTSTRAP_ADMIN_USER=
# BOOTSTRAP_ADMIN_PASSWORD=
